include README.md LICENSE NOTICE CONTRIBUTING.md CHANGELOG.md
include requirements-linux-cu128-py311.txt requirements-demo-linux-cu128-py311.txt
recursive-include configs *.json
recursive-include docs *.md
recursive-include provenance *.json
recursive-include scripts *.py
recursive-include tests *.py
exclude docs/backup-policy.md docs/release-readiness.md
prune .private
prune weights
prune outputs
global-exclude __pycache__ *.py[cod]
recursive-include assets *.svg *.png
recursive-include recipes *.csv *.example
recursive-include site *.html *.css *.js *.png *.svg *.bib
